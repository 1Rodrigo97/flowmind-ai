# ---- Database ----
# When running the backend on the host against the Docker Postgres:
DATABASE_URL=postgresql+psycopg://flowmind:flowmind@localhost:5432/flowmind
POSTGRES_USER=flowmind
POSTGRES_PASSWORD=flowmind
POSTGRES_DB=flowmind

# ---- LLM provider ----
LLM_PROVIDER=ollama
# From the host use localhost; from inside a container use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT=120
# Bounded context window keeps memory predictable on modest/local hardware.
LLM_NUM_CTX=4096

# ---- Embeddings ----
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ---- RAG ----
RETRIEVAL_TOP_K=5
# Minimum cosine similarity (0..1) a chunk must reach to be trusted as context.
# Calibrated for nomic-embed-text: on-topic chunks score ~0.75+, unrelated ~0.40.
SIMILARITY_THRESHOLD=0.55

# ---- Reranking (V2) ---- disabled by default so the V1 pipeline is unchanged.
RERANKER_ENABLED=false
RERANKER_MODEL=lexical
RERANKER_CANDIDATES=15
RERANKER_TOP_K=5

# ---- Automation (n8n pillar) ----
# Service token n8n sends as "Authorization: Bearer ...". Empty disables auth (dev).
FLOWMIND_AUTOMATION_TOKEN=
AUTOMATION_MAX_ATTEMPTS=3
# In Docker these are set to /data/automation/* by docker-compose; on the host the
# defaults (automation/inbox|processed|failed) are used.
# AUTOMATION_INBOX_DIR=automation/inbox
# AUTOMATION_PROCESSED_DIR=automation/processed
# AUTOMATION_FAILED_DIR=automation/failed

# ---- Ingestion ----
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,docx,md,txt
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
