# Environment / secrets
.env
*.env
.env.local
.env.*.local
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Uploaded documents (real user data)
uploads/
backend/uploads/

# Automation folders: keep the structure, ignore real files dropped by the user.
automation/inbox/*
automation/processed/*
automation/failed/*
!automation/inbox/.gitkeep
!automation/processed/.gitkeep
!automation/failed/.gitkeep

# n8n local data volume
n8n/data/

# Database dumps / data
*.sql
*.dump
pgdata/

# Model files / caches
*.gguf
*.bin
*.safetensors
.cache/
# Downloaded model files at the repo root (not the backend app/models package).
/models/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# Evaluation output
evaluation/results/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Emitted TS build artifacts (should never be checked in)
vite.config.js
vite.config.d.ts
*.tsbuildinfo
